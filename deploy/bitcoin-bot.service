[Unit]
Description=Bitcoin Trading Bot
After=network.target

[Service]
Type=simple
User=trading_bot
Group=trading_bot
WorkingDirectory=/opt/bitcoin-bot

ExecStart=/opt/bitcoin-bot/venv/bin/python3 -m bitcoin_bot.main

Restart=on-failure
RestartSec=10

Environment="PYTHONUNBUFFERED=1"

# Security hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
